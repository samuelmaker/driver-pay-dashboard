# Spoke API key (keep secret)
SPOKE_API_KEY=

# JSON mapping of username -> pin (server-only). Example: {"sam": "123456", "dwayne": "654321"}
PIN_STORE_JSON={}

# JWT secret for signing session cookies
JWT_SECRET=replace_this_with_a_secure_random_value

# Pay rate in GBP per hour
PAY_RATE=15

# Optional: default month (YYYY-MM) for testing
DEFAULT_MONTH=
